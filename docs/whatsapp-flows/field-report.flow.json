{
  "version": "7.3",
  "screens": [
    {
      "id": "REPORT",
      "title": "Field Activity Report",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextInput", "name": "project",  "label": "Project",  "input-type": "text", "required": true },
          { "type": "TextInput", "name": "state",    "label": "State",    "input-type": "text", "required": true },
          { "type": "TextInput", "name": "location", "label": "Village / location", "input-type": "text", "required": true },
          { "type": "TextInput", "name": "beneficiaries", "label": "Beneficiaries met", "input-type": "number", "required": true },
          {
            "type": "Dropdown",
            "name": "area_of_intervention",
            "label": "Activity type",
            "required": true,
            "data-source": [
              { "id": "Training / Workshop",   "title": "Training / Workshop",   "description": "Capacity building session" },
              { "id": "Household Survey",      "title": "Household Survey",      "description": "Data collection" },
              { "id": "Material Distribution", "title": "Material Distribution", "description": "Kit / input distribution" },
              { "id": "Community Meeting",     "title": "Community Meeting",     "description": "SHG / village meeting" },
              { "id": "Other Activity",        "title": "Other Activity",        "description": "Any other activity" }
            ]
          },
          { "type": "TextArea", "name": "description", "label": "What happened?", "helper-text": "Briefly describe it in 2-3 sentences", "max-length": 600, "required": true },
          {
            "type": "Footer",
            "label": "Submit",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "project": "${form.project}",
                "state": "${form.state}",
                "location": "${form.location}",
                "village": "${form.location}",
                "beneficiaries": "${form.beneficiaries}",
                "area_of_intervention": "${form.area_of_intervention}",
                "activity_type": "${form.area_of_intervention}",
                "description": "${form.description}"
              }
            }
          }
        ]
      }
    }
  ]
}
