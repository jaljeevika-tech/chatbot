{
  "version": "7.3",
  "screens": [
    {
      "id": "REPORT",
      "title": "Daily Field Report",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Dropdown",
            "name": "project",
            "label": "Project",
            "required": true,
            "data-source": [
              { "id": "Dasara",                "title": "Dasara" },
              { "id": "Kosi Sahajivan",        "title": "Kosi Sahajivan" },
              { "id": "UNDP ECRIC Project",    "title": "UNDP ECRIC Project" },
              { "id": "TATWA",                 "title": "TATWA" },
              { "id": "Internal Program",      "title": "Internal Program" },
              { "id": "Jal Nidhi – Herbalife", "title": "Jal Nidhi – Herbalife" },
              { "id": "Other / अन्य",          "title": "Other / अन्य" }
            ]
          },
          {
            "type": "Dropdown",
            "name": "state",
            "label": "State",
            "required": true,
            "data-source": [
              { "id": "Bihar",          "title": "Bihar" },
              { "id": "Jharkhand",      "title": "Jharkhand" },
              { "id": "Uttar Pradesh",  "title": "Uttar Pradesh" },
              { "id": "Madhya Pradesh", "title": "Madhya Pradesh" },
              { "id": "Maharashtra",    "title": "Maharashtra" },
              { "id": "Odisha",         "title": "Odisha" },
              { "id": "West Bengal",    "title": "West Bengal" },
              { "id": "Rajasthan",      "title": "Rajasthan" },
              { "id": "Other / अन्य",   "title": "Other / अन्य" }
            ]
          },
          { "type": "TextInput", "name": "location", "label": "Location", "input-type": "text", "helper-text": "Village / block / district — गाँव/ब्लॉक/जिला", "required": true },
          {
            "type": "Dropdown",
            "name": "area_of_intervention",
            "label": "Activity type",
            "required": true,
            "data-source": [
              { "id": "Community Mobilization",          "title": "Community Mobilization" },
              { "id": "Beneficiary Training",            "title": "Beneficiary Training" },
              { "id": "Beneficiary Exposure Visit",      "title": "Beneficiary Exposure Visit" },
              { "id": "Beneficiary Input Distribution",  "title": "Beneficiary Input Distribution" },
              { "id": "Camp & Convergence",              "title": "Camp & Convergence" },
              { "id": "Collective Development",          "title": "Collective Development" },
              { "id": "Enterprise Development Support",  "title": "Enterprise Development Support" },
              { "id": "Input & Financial Linkage",       "title": "Input & Financial Linkage" },
              { "id": "Documentation & Report",          "title": "Documentation & Report" },
              { "id": "Any Other",                       "title": "Any Other" }
            ]
          },
          { "type": "TextInput", "name": "beneficiaries", "label": "Beneficiaries", "input-type": "number", "helper-text": "How many were reached? कितने लाभार्थी थे?", "required": true },
          { "type": "TextArea", "name": "description", "label": "Activity description", "helper-text": "Describe today's activity in 1-2 sentences", "max-length": 600, "required": true },
          {
            "type": "Footer",
            "label": "Submit",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "project": "${form.project}",
                "state": "${form.state}",
                "location": "${form.location}",
                "area_of_intervention": "${form.area_of_intervention}",
                "beneficiaries": "${form.beneficiaries}",
                "description": "${form.description}"
              }
            }
          }
        ]
      }
    }
  ]
}
