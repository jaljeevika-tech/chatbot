# Service-account credentials — never commit these, ever. The app loads this
# credential from FIREBASE_ADMIN_SDK_JSON (env/Secret Manager) instead; a
# local copy of the file is a stale liability, not something the code needs.
firebase-adminsdk.json
*serviceaccount*.json
*service-account*.json

